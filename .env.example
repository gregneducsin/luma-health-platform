# ─────────────────────────────────────────────────────────────────────────────
# Luma Health Platform — Environment Variables Reference
#
# Copy to .env and fill in values for local development:
#   cp .env.example .env
#
# This file is loaded automatically in development via `--env-file=.env`
# (Node's built-in env-file loader — no dotenv dependency needed).
# Never commit .env to version control (it's already gitignored).
# ─────────────────────────────────────────────────────────────────────────────

# ── Database (required) ────────────────────────────────────────────────────────
# PostgreSQL 16 connection string. No default — the app refuses to start without it.
DATABASE_URL=postgres://luma:localdev@localhost:5432/luma_health

# ── API server ───────────────────────────────────────────────────────────────
# TCP port the API server binds to. Default: 3001.
PORT=3001
# "development", "production", or "test". Default: development.
NODE_ENV=development
# Pino log level: error | warn | info | debug. Default: info.
LOG_LEVEL=info

# Comma-separated list of allowed CORS origins (browser origins allowed to send
# credentialed requests to the API), e.g. https://app.example.com,https://staging.example.com
# No default — required in production. In development, defaults to the dashboard
# dev server's own origin (http://localhost:5173) if unset.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Comma-separated admin email addresses seeded on first successful migration+seed run.
# Trimmed, lowercased, validated, and deduplicated automatically. Seeded users have
# no password set yet — the seed step prints a one-time invitation link to stdout
# (see packages/db/src/seed.ts) which is the only way to activate the account.
# If unset, no bootstrap admin users are created (a warning is logged, not an error).
BOOTSTRAP_ADMIN_EMAILS=

# Public base URL of the dashboard, used only to build human-shareable links
# (bootstrap-admin invitation links, password-reset links) printed to stdout.
# No email transport is wired up in this phase — these links are
# operator-visible only. Leave unset to get relative paths (fine for local
# development). e.g. https://app.example.com
WEB_PUBLIC_URL=

# ── Webhook secrets (shared-secret header, constant-time compared) ────────────
# Generate a new random value per environment — do not reuse across dev/staging/prod.
GHL_WEBHOOK_SECRET=
ORDER_WEBHOOK_SECRET=
QUESTIONNAIRE_WEBHOOK_SECRET=
FAILED_PAYMENT_WEBHOOK_SECRET=

# ── Dashboard (Vite dev server only — production build has no runtime env vars) ─
# Port the Vite dev server binds to. Default: 5173.
WEB_PORT=5173
# Base path the dashboard is mounted at. Default: "/". Only change if serving
# the SPA from a subpath (e.g. "/dashboard").
BASE_PATH=/
# Dev-only: which local port the dashboard's dev-server proxy forwards /api/*
# requests to. Should match PORT above. Default: 3001.
API_PROXY_PORT=3001

# ── Testing only — do not set in development or production ────────────────────
# Isolates a test run to a named Postgres schema (e.g. _luma_test_ci). Set
# automatically by the test harness; never set this by hand.
POSTGRES_SCHEMA=
